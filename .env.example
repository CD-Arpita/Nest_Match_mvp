# Copy this file to `.env` for local development and fill in real values.
# In production (Streamlit Community Cloud), set these as Secrets instead
# -- see README.md.

# Required -- get a free key at console.groq.com (no card ever needed)
GROQ_API_KEY=gsk_...

# Optional -- defaults to llama-3.3-70b-versatile if unset
GROQ_MODEL=llama-3.3-70b-versatile

# Optional -- leave both blank to run in local-file demo mode (no database
# setup needed). Fill both in to use Supabase instead.
SUPABASE_URL=
SUPABASE_KEY=
